  m_Script: {fileID: 11500000, guid: f96963f1a92f98b44bcf882f789f351e, type: 3}
  m_Name: SuspiciousAltar
  m_EditorClassIdentifier: Assembly-CSharp::EventConfig
  Background: {fileID: 21300000, guid: bd65335d989174d4db96c1fd64dd082b, type: 3}
  Title: "\uC218\uC0C1\uD55C \uC81C\uB2E8"
  Dialogue: "\uAC80\uC740 \uB3CC \uC81C\uB2E8 \uC704\uC5D0 \uC624\uB798\uB41C \uBB38\uC7A5\uC774
    \uC0C8\uACA8\uC838 \uC788\uC2B5\uB2C8\uB2E4. \uD53C\uB97C \uBC14\uCE58\uBA74
    \uD798\uC744 \uB0B4\uC5B4\uC8FC\uACA0\uB2E4\uB294 \uB4EF \uB0AE\uAC8C \uC6B8\uB9BD\uB2C8\uB2E4."
  Choices:
  - ChoiceText: "\uD53C\uB97C \uBC14\uCE5C\uB2E4"
    PreviewText: "HP {hpCost}\uC744 \uC783\uACE0, \uBBF8\uBCF4\uC720 \uC601\uAD6C
      \uC720\uBB3C 1\uAC1C\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    NoRelicPreviewText: "\uBC1B\uC744 \uC218 \uC788\uB294 \uBBF8\uBCF4\uC720 \uC720\uBB3C\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4."
    InsufficientHealthPreviewText: "\uCCB4\uB825\uC774 \uBD80\uC871\uD574 \uC81C\uBB3C\uC744
      \uBC14\uCE60 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    ResultText: "HP\uB97C {hpLost} \uC783\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC81C\uB2E8\uC774
      [{relicName}]\uC744 \uB0B4\uB824\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4.\n{relicDescription}"
    NoRelicResultText: "\uC81C\uB2E8\uC740 \uC544\uBB34\uAC83\uB3C4 \uB0B4\uB824\uC8FC\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC774\uBBF8 \uBAA8\uB4E0 \uC720\uBB3C\uC744
      \uBCF4\uC720 \uC911\uC785\uB2C8\uB2E4."
    DisableWhenNoUnownedRelic: 1
    DisableWhenInsufficientHealth: 1
    Effects:
    - Type: 1
      Value: 20
    - Type: 2
      Value: 0
  - ChoiceText: "\uADF8\uB0E5 \uC9C0\uB098\uAC04\uB2E4"
    PreviewText: "\uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    NoRelicPreviewText: 
    InsufficientHealthPreviewText: 
    ResultText: "\uB2F9\uC2E0\uC740 \uC81C\uB2E8\uC758 \uC18D\uC0AD\uC784\uC744 \uB4A4\uB85C\uD558\uACE0
      \uAE38\uC744 \uB5A0\uB0AC\uC2B5\uB2C8\uB2E4."
    NoRelicResultText: 
    DisableWhenNoUnownedRelic: 0
    DisableWhenInsufficientHealth: 0
    Effects:
    - Type: 0
      Value: 0
