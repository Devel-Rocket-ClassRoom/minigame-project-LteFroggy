  Title: "\uBCF4\uBB3C\uC0C1\uC790"
  Dialogue: "\uB0A1\uC740 \uC0C1\uC790\uAC00 \uAE38\uBAA9\uC5D0 \uB193\uC5EC \uC788\uC2B5\uB2C8\uB2E4.
    \uC548\uCABD\uC5D0\uC11C\uB294 \uD76C\uBBF8\uD55C \uBE5B\uC774 \uC0C8\uC5B4 \uB098\uC635\uB2C8\uB2E4."
  Choices:
  - ChoiceText: "\uC0C1\uC790\uB97C \uC5F0\uB2E4"
    PreviewText: "\uBBF8\uBCF4\uC720 \uC601\uAD6C \uC720\uBB3C 1\uAC1C\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4."
    NoRelicPreviewText: "\uC774\uBBF8 \uBAA8\uB4E0 \uC720\uBB3C\uC744 \uBCF4\uC720
      \uC911\uC785\uB2C8\uB2E4."
    InsufficientHealthPreviewText: 
    ResultText: "\uC0C1\uC790 \uC548\uC5D0\uC11C [{relicName}]\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.\n{relicDescription}"
    NoRelicResultText: "\uC0C1\uC790\uB294 \uBE44\uC5B4 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC774\uBBF8 \uBAA8\uB4E0 \uC720\uBB3C\uC744 \uBCF4\uC720 \uC911\uC785\uB2C8\uB2E4."
